# ==============================================================================
# EMailAutomation — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==============================================================================

# --- Flask ---
SECRET_KEY=your-random-secret-key-here
FLASK_DEBUG=true

# --- Gmail SMTP ---
# Use a Gmail App Password (NOT your regular password).
# Steps: Google Account → Security → 2FA → App Passwords → Create
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
GMAIL_ADDRESS=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM_NAME=Your Name or Company

# --- Google Sheets ---
# Full URL of your Google Sheet (the one you share with the service account)
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit

# Service Account credentials — use ONE of these two options:
# Option 1: Paste the entire JSON content (best for Render / cloud deploy)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Option 2: Path to the JSON key file (best for local development)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Column name in your sheet that tracks email status (pending/sent/failed)
SHEET_STATUS_COLUMN=Status

# --- Webhook Security ---
# API key that your external cron service must send in the X-API-Key header
TRIGGER_API_KEY=your-secret-api-key-here

# --- Database ---
DATABASE_PATH=email_logs.db

# --- Email Defaults ---
DEFAULT_EMAIL_SUBJECT=Hello {{name}}!
DEFAULT_TEMPLATE=default.html
